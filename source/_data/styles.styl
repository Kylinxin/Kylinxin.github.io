:root {
  --kx-accent: #00d4a4;
  --kx-accent-strong: #00b48a;
  --kx-ink: #171717;
  --kx-muted: #5a5a5c;
  --kx-soft: #f7f8f8;
  --kx-panel: #ffffff;
  --kx-border: #e5e5e5;
  --kx-code: #1c1c1e;
}

body {
  background:
    radial-gradient(circle at 78% 0, rgba(245, 233, 216, .92), rgba(245, 233, 216, 0) 34rem),
    linear-gradient(135deg, rgba(135, 168, 200, .45), rgba(255, 255, 255, 0) 22rem),
    var(--body-bg-color);
  color: var(--text-color);
  letter-spacing: 0;
}

.headband {
  background: linear-gradient(90deg, var(--kx-accent), #3772cf);
  height: 2px;
}

.site-brand-container {
  background: transparent;
  border-bottom: 1px solid rgba(23, 23, 23, .08);
  box-shadow: none;
}

.brand {
  border-radius: 9999px;
  color: var(--brand-color);
  font-weight: 700;
}

.site-title {
  font-size: 1.38em;
  font-weight: 750;
}

.site-subtitle,
.site-description {
  display: none;
}

.site-nav {
  background: transparent;
  border-bottom: 0;
  box-shadow: none;
}

.menu .menu-item a {
  border-radius: 9999px;
  color: var(--kx-muted);
  font-size: .86em;
  font-weight: 650;
  padding: 8px 12px;
  transition: background .2s ease, color .2s ease;
}

.menu .menu-item a:hover {
  background: rgba(0, 212, 164, .12);
  color: var(--kx-ink);
}

.site-nav-right .toggle,
.site-nav-toggle .toggle {
  border-radius: 9999px;
}

.main {
  padding-top: 8px;
}

.main-inner.index {
  max-width: 1040px;
}

.home-hero {
  background:
    linear-gradient(135deg, rgba(255,255,255,.72), rgba(255,255,255,.42)),
    linear-gradient(135deg, rgba(135,168,200,.28), rgba(245,233,216,.35));
  border: 1px solid rgba(23,23,23,.08);
  border-radius: 18px;
  box-shadow: 0 28px 70px rgba(23,23,23,.08);
  color: var(--kx-ink);
  display: block;
  margin: 0 0 22px;
  padding: 72px 56px 78px;
}

.home-hero h1 {
  font-size: clamp(3.4rem, 8vw, 6.6rem);
  font-weight: 780;
  letter-spacing: 0;
  line-height: .98;
  margin: 0;
}

.main-inner.index .post-block {
  background: rgba(255,255,255,.82);
  border: 1px solid var(--kx-border);
  border-radius: 16px;
  box-shadow: none;
  margin-bottom: 14px;
  padding: 24px 28px;
  opacity: 1 !important;
  transform: none !important;
  visibility: visible !important;
}

.main-inner.index .post-block:first-of-type {
  padding-top: 24px;
}

.main-inner.index .post-header {
  margin-bottom: 0;
}

.main-inner.index .post-content,
.main-inner.index .post-header,
.main-inner.index .post-title,
.main-inner.index .post-meta-container,
.main-inner.index .post-meta {
  opacity: 1 !important;
  transform: none !important;
  visibility: visible !important;
}

.main-inner.index .post-title {
  font-size: 1.35em;
  line-height: 1.25;
  margin: 0 0 10px;
  text-align: left;
}

.main-inner.index .post-title-link {
  color: var(--kx-ink);
  border-bottom: 0;
}

.main-inner.index .post-title-link:hover {
  color: var(--kx-accent-strong);
}

.main-inner.index .post-meta-container {
  text-align: left;
}

.main-inner.index .post-meta {
  color: var(--kx-muted);
  font-size: .82em;
}

.main-inner.index .post-body,
.main-inner.index .post-footer {
  display: none;
}

.main-inner.index .pagination {
  background: transparent;
  border: 0;
  box-shadow: none;
}

.post-block,
.pagination,
.comments {
  border: 1px solid rgba(23,23,23,.08);
  border-radius: 16px;
  box-shadow: none;
}

.post-body {
  font-size: 1.02em;
}

.post-body figure.highlight,
.post-body pre {
  border-radius: 12px;
}

.sidebar-inner {
  border: 1px solid rgba(23,23,23,.08);
  border-radius: 16px;
  box-shadow: none;
}

.site-author-image {
  border: 2px solid rgba(0, 212, 164, .36);
}

.site-author-name {
  font-weight: 750;
}

@media (prefers-color-scheme: dark) {
  :root {
    --kx-accent: #5e6ad2;
    --kx-accent-strong: #828fff;
    --kx-ink: #f7f8f8;
    --kx-muted: #8a8f98;
    --kx-soft: #010102;
    --kx-panel: #0f1011;
    --kx-border: #23252a;
    --kx-code: #010102;
  }

  body {
    background:
      radial-gradient(circle at 82% 0, rgba(94, 106, 210, .26), rgba(94, 106, 210, 0) 36rem),
      linear-gradient(135deg, #010102, #141516);
  }

  .site-brand-container {
    border-bottom-color: rgba(255,255,255,.08);
  }

  .menu .menu-item a {
    color: var(--kx-muted);
  }

  .menu .menu-item a:hover {
    background: rgba(94, 106, 210, .18);
    color: var(--kx-ink);
  }

  .home-hero {
    background:
      radial-gradient(circle at 78% 0, rgba(94, 106, 210, .36), rgba(94, 106, 210, 0) 34rem),
      linear-gradient(135deg, rgba(15,16,17,.96), rgba(20,21,22,.94));
    border-color: var(--kx-border);
    box-shadow: 0 30px 80px rgba(0,0,0,.28);
    color: var(--kx-ink);
  }

  .main-inner.index .post-block,
  .post-block,
  .pagination,
  .comments,
  .sidebar-inner {
    background: rgba(15,16,17,.88);
    border-color: var(--kx-border);
  }

  .main-inner.index .post-title-link {
    color: var(--kx-ink);
  }

  .main-inner.index .post-title-link:hover {
    color: var(--kx-accent-strong);
  }

  .site-author-image {
    border-color: rgba(94, 106, 210, .5);
  }
}

@media (max-width: 767px) {
  .main {
    padding-top: 0;
  }

  .home-hero {
    margin-top: 4px;
    margin-bottom: 14px;
    padding: 46px 26px 48px;
  }

  .home-hero h1 {
    font-size: clamp(2.5rem, 15vw, 4.2rem);
  }

  .main-inner.index .post-block {
    background: rgba(255,255,255,.9);
    margin-bottom: 12px;
    padding: 20px;
  }

  @media (prefers-color-scheme: dark) {
    .main-inner.index .post-block {
      background: rgba(20,21,22,.96);
      border-color: #34343a;
    }
  }
}
